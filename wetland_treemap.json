
{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Victorian wetland types by mapped area",
  "width": 800,
  "height": 460,
  "padding": 5,
  "autosize": "pad",

  "title": {
    "text": "Victoria's Wetland Types",
    "subtitle": "Rectangle size represents mapped area in hectares",
    "fontSize": 20,
    "color": "#174d43",
    "anchor": "start"
  },

  "data": [
    {
      "name": "wetlands",
      "url": "victorian_wetland_types.json",
      "format": {
        "type": "json",
        "property": "features"
      },
      "transform": [
        {
          "type": "formula",
          "as": "wetland_type",
          "expr": "datum.attributes.wtlnd_type"
        },
        {
          "type": "formula",
          "as": "area",
          "expr": "datum.attributes.total_area_ha"
        },
        {
          "type": "formula",
          "as": "count",
          "expr": "datum.attributes.wetland_count"
        },
        {
          "type": "filter",
          "expr": "datum.area > 0"
        },
        {
          "type": "nest"
        },
        {
          "type": "treemap",
          "field": "area",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "method": "squarify",
          "paddingInner": 3,
          "size": [
            {"signal": "width"},
            {"signal": "height"}
          ]
        }
      ]
    }
  ],

  "scales": [
    {
      "name": "color",
      "type": "linear",
      "domain": {
        "data": "wetlands",
        "field": "area"
      },
      "range": ["#A9D7CD", "#15574E"]
    }
  ],

  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "wetlands"
      },
      "encode": {
        "enter": {
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 2
          },
          "tooltip": {
            "signal": "{'Wetland type': datum.wetland_type, 'Area (ha)': format(datum.area, ',.1f'), 'Mapped polygons': format(datum.count, ',')}"
          }
        },
        "update": {
          "x": {"field": "x0"},
          "y": {"field": "y0"},
          "x2": {"field": "x1"},
          "y2": {"field": "y1"},
          "fill": {
            "scale": "color",
            "field": "area"
          }
        },
        "hover": {
          "fill": {
            "value": "#E2AB65"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "wetlands"
      },
      "encode": {
        "enter": {
          "fill": {"value": "#123B35"},
          "fontSize": {"value": 11},
          "fontWeight": {"value": "bold"},
          "align": {"value": "left"},
          "baseline": {"value": "top"}
        },
        "update": {
          "x": {
            "signal": "datum.x0 + 7"
          },
          "y": {
            "signal": "datum.y0 + 7"
          },
          "text": {
            "signal": "(datum.x1-datum.x0 > 125 && datum.y1-datum.y0 > 35) ? datum.wetland_type : ''"
          }
        }
      }
    }
  ],

  "config": {
    "background": "white"
  }
}
