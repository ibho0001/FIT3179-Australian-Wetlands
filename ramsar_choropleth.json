
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Ramsar Wetlands by State",
    "subtitle": "Number of internationally important Ramsar sites",
    "fontSize": 20,
    "anchor": "start",
    "color": "#174d43"
  },
  "width": 800,
  "height": 440,
  "projection": {
    "type": "mercator",
    "center": [134, -25],
    "scale": 570,
    "translate":[400,195]
  },
  "data": {
    "url": "australian_states_vega_fixed.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "ramsar_sites_by_region.csv"
        },
        "key": "region",
        "fields": ["ramsar_site_count"]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1.5
  },
  "encoding": {
    "color": {
  "field": "ramsar_site_count",
  "type": "quantitative",
  "scale": {
    "range": ["#b9ddd8", "#2c5f91"]
  },
  "legend": {
    "title": "Number of Ramsar sites",
    "orient": "none",
    "direction": "horizontal",
    "legendX": 20,
    "legendY": 65,
    "gradientLength": 140,
    "gradientThickness": 12,
    "titleFont": "DM Sans",
    "labelFont": "DM Sans",
    "titleFontSize": 12,
    "labelFontSize": 11,
    "titleColor": "#0d4f57",
    "labelColor": "#243b35",
    "format": ".0f"
  }
},
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "title": "State"
      },
      {
        "field": "ramsar_site_count",
        "title": "Ramsar sites",
        "format": ".0f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}
